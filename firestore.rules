rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function platformOwner() {
      return signedIn() && request.auth.token.get("platform_owner", false) == true;
    }
    function membershipPath(tenantId) {
      return /databases/$(database)/documents/memberships/$(tenantId + "_" + request.auth.uid);
    }
    function canResolveMembership(membershipId) {
      let path = /databases/$(database)/documents/memberships/$(membershipId);
      return signedIn()
        && request.auth.uid.matches("^[A-Za-z0-9_-]{1,128}$")
        && membershipId.matches("^.+_" + request.auth.uid + "$")
        && (!exists(path) || get(path).data.userId == request.auth.uid);
    }
    function hasActiveMembership(tenantId) {
      return signedIn()
        && exists(membershipPath(tenantId))
        && get(membershipPath(tenantId)).data.tenantId == tenantId
        && get(membershipPath(tenantId)).data.userId == request.auth.uid
        && get(membershipPath(tenantId)).data.status == "active";
    }
    function hasRole(tenantId, roles) {
      return hasActiveMembership(tenantId)
        && get(membershipPath(tenantId)).data.role in roles;
    }
    function tenantOwner(tenantId) { return hasRole(tenantId, ["tenant_owner"]); }
    function tenantStaff(tenantId) {
      return hasRole(tenantId, ["tenant_owner", "tenant_admin", "staff", "cashier"]);
    }
    function tenantAdmin(tenantId) {
      return hasRole(tenantId, ["tenant_owner", "tenant_admin"]);
    }
    function tenantDriver(tenantId) { return hasRole(tenantId, ["driver"]); }
    function tenantIsActive(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == "active";
    }
    function assignedDriver(tenantId, orderId) {
      let deliveryPath = /databases/$(database)/documents/tenants/$(tenantId)/deliveries/$(orderId);
      return tenantDriver(tenantId) && exists(deliveryPath)
        && get(deliveryPath).data.driverId == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid || platformOwner();
      allow list: if platformOwner();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "photoURL", "createdAt", "updatedAt"]);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "photoURL", "updatedAt"]);
      allow delete: if false;
    }

    match /memberships/{membershipId} {
      allow get: if platformOwner()
        || canResolveMembership(membershipId)
        || (signedIn() && resource.data.userId == request.auth.uid)
        || tenantAdmin(resource.data.tenantId);
      allow list: if platformOwner() || tenantAdmin(resource.data.tenantId);
      // Memberships mudam por callable backend para manter trilha de auditoria.
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if platformOwner() || tenantStaff(tenantId) || tenantDriver(tenantId) || resource.data.status == "active";
      allow list: if platformOwner() || resource.data.status == "active";
      allow create, update, delete: if false;

      match /settings/{settingsId} {
        allow get: if platformOwner() || tenantStaff(tenantId) || (tenantIsActive(tenantId) && settingsId == "main");
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if platformOwner() || tenantStaff(tenantId) || (tenantIsActive(tenantId) && resource.data.active == true);
        allow create, update: if false;
        allow delete: if false;
      }

      match /products/{productId} {
        allow read: if platformOwner() || tenantStaff(tenantId) || (tenantIsActive(tenantId) && resource.data.available == true);
        allow create, update: if false;
        allow delete: if false;
      }

      match /orders/{orderId} {
        allow get: if platformOwner() || tenantStaff(tenantId)
          || (signedIn() && resource.data.customerId == request.auth.uid)
          || assignedDriver(tenantId, orderId);
        allow list: if platformOwner() || tenantStaff(tenantId)
          || (signedIn() && resource.data.customerId == request.auth.uid);
        // Clientes nunca escrevem totais, estados operacionais nem códigos confiáveis.
        // createOrder/updateOrderStatus executam no backend com Admin SDK.
        allow create, update, delete: if false;
      }

      match /publicOrderTracking/{publicCode} {
        allow get: if tenantIsActive(tenantId)
          && resource.data.publicCode == publicCode;
        allow list, create, update, delete: if false;
      }

      match /deliveries/{deliveryId} {
        allow get, list: if platformOwner() || tenantStaff(tenantId)
          || (tenantDriver(tenantId) && resource.data.driverId == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /auditLogs/{auditId} {
        allow get, list: if platformOwner() || tenantOwner(tenantId) || hasRole(tenantId, ["tenant_admin"]);
        allow create, update, delete: if false;
      }
    }

    match /tenantSlugs/{slug} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
