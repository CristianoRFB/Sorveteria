{
  "name": "saas-sorveteria-multitenant-whitelabel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "emulators": "firebase emulators:start --project demo-sorveteria --only auth,firestore,functions,storage",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-sorveteria --only firestore,storage \"vitest run --config vitest.rules.config.ts tests/rules\"",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:run": "vitest run --config vitest.integration.config.ts tests/integration",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "docs:diagrams": "node scripts/docs-diagrams.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:leads": "node scripts/docs-leads.mjs",
    "qa:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.7.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
